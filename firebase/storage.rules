rules_version = '2';

// PetNest Cloud Storage rules.
service firebase.storage {
  match /b/{bucket}/o {

    // petPhotos/<ownerUid>/<petId>
    // Readable by any signed-in user (the app shows them through download
    // URLs); only the owner uploads.
    match /petPhotos/{ownerId}/{petId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
          && request.auth.uid == ownerId
          && request.resource.size < 5 * 1024 * 1024
          && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == ownerId;
    }

    // vetCertificates/<vetUid>/<fileName>
    // Private: only the vet (and admins through the console) can read them.
    match /vetCertificates/{vetId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == vetId;
      allow create, update: if request.auth != null
          && request.auth.uid == vetId
          && request.resource.size < 10 * 1024 * 1024
          && request.resource.contentType.matches('application/pdf|image/png|image/jpeg');
      allow delete: if request.auth != null && request.auth.uid == vetId;
    }
  }
}
